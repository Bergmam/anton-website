---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Anton Bargman – Software Engineer & Game Developer" } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: Georgia, serif;
        background: #0f0f0f;
        color: #e8e8e8;
        line-height: 1.7;
      }
      a { color: #c8a96e; text-decoration: none; }
      a:hover { text-decoration: underline; }
      nav {
        padding: 1.5rem 2rem;
        border-bottom: 1px solid #222;
        display: flex;
        gap: 2rem;
        align-items: center;
      }
      nav .home { font-weight: bold; color: #e8e8e8; }
      main {
        max-width: 760px;
        margin: 0 auto;
        padding: 4rem 2rem;
      }
    </style>
  </head>
  <body>
    <nav>
      <a href="/" class="home">Anton Bargman</a>
      <a href="/tileshire">Tileshire</a>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
